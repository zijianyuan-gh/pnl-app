# Used by Cloudflare Pages / Netlify (ignored elsewhere).
# The service worker and HTML must always be revalidated so new versions are picked up.
/sw.js
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
/manifest.webmanifest
  Cache-Control: no-cache
/assets/*
  Cache-Control: public, max-age=31536000, immutable
